# FiveM Enhanced Server Configuration

# License key from https://keymaster.fivem.net (REQUIRED)
LICENSE_KEY=replace_me

# Server Settings
SERVER_NAME=FiveM Enhanced Server
SERVER_DESC=A FiveM Enhanced Server running in Docker
SERVER_TAGS=default
MAX_CLIENTS=32
LOCALE=en-US

# Game Build (GTA Enhanced)
# GAME_BUILD=2802

# API Keys
STEAM_API_KEY=none

# Database (optional)
# MYSQL_CONNECTION=mysql://user:password@localhost:3306/database

# RCON
RCON_PASSWORD=changeme

# Whitelist (0=off, 1=on)
WHITELIST=0

# Logging
LOG_PATH=
LOG_BANS=1
LOG_HEARTBEATS=1
