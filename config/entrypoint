#!/bin/sh

if [ -n "$DEBUG" ]; then
    set -x
fi

mkdir -p /fivem-data/resources /fivem-data/data

TEMPLATE_FILE="/fivem-data/server.cfg.template"
if [ ! -f "$TEMPLATE_FILE" ]; then
    >&2 echo "No server.cfg.template found in /fivem-data, copying default from image..."
    cp /opt/cfx-server-data/server.cfg.template "$TEMPLATE_FILE"
fi

# Rendered purely inside the container (tmpfs) - never written back to the /fivem-data mount.
RENDERED_CFG="/server/.fxs_home/server.cfg"

if [ -f "$TEMPLATE_FILE" ]; then
    >&2 echo "Generating server.cfg from template (container-only, not exposed via mount)..."
    >&2 echo ""

    >&2 echo "Found variables in template:"
    VARS=$(grep -o '\${[A-Za-z_][A-Za-z0-9_]*}' "$TEMPLATE_FILE" | sed 's/[${}]//g' | sort -u)

    for VAR_NAME in $VARS; do
        VAR_VALUE=$(eval echo \$$VAR_NAME)
        if [ -n "$VAR_VALUE" ]; then
            >&2 echo "  ✓ \${$VAR_NAME} = $VAR_VALUE"
        else
            >&2 echo "  ✗ \${$VAR_NAME} = (not set)"
        fi
    done

    >&2 echo ""
    >&2 echo "Replacing variables in server.cfg..."
    cp "$TEMPLATE_FILE" "$RENDERED_CFG"

    for VAR_NAME in $VARS; do
        VAR_VALUE=$(printenv "$VAR_NAME")
        if [ -n "$VAR_VALUE" ]; then
            ESCAPED_VALUE=$(printf '%s\n' "$VAR_VALUE" | sed -e 's/[#\&/|]/\\&/g')
            sed -i "s#\${$VAR_NAME}#$ESCAPED_VALUE#g" "$RENDERED_CFG"
            >&2 echo "  Replaced \${$VAR_NAME}"
        fi
    done

    >&2 echo "✓ server.cfg generated successfully"
fi

# Bundled system resources are only kept when enabled. txAdmin is on when
# ENABLE_TXADMIN=1 or when running in txAdmin mode (NO_DEFAULT_CONFIG set).
# chat is only kept when ENABLE_CHAT=1.
SYSTEM_RESOURCES="/server/alpine/opt/cfx-server/system_resources"

if [ "${ENABLE_TXADMIN}" != "1" ] && [ -z "${NO_DEFAULT_CONFIG}" ]; then
    if [ -d "$SYSTEM_RESOURCES/txadmin" ]; then
        >&2 echo "txAdmin disabled, removing bundled txadmin resource"
        rm -rf "$SYSTEM_RESOURCES/txadmin"
    fi
fi

if [ "${ENABLE_CHAT}" != "1" ]; then
    if [ -d "$SYSTEM_RESOURCES/chat" ]; then
        >&2 echo "chat disabled, removing bundled chat resource"
        rm -rf "$SYSTEM_RESOURCES/chat"
    fi
    if [ -f "$RENDERED_CFG" ]; then
        sed -i '/^[[:space:]]*\(start\|ensure\)[[:space:]]\+chat[[:space:]]*$/d' "$RENDERED_CFG"
    fi
fi

CONFIG_ARGS=""
if [ -z "${NO_DEFAULT_CONFIG}" ]; then
    CONFIG_ARGS="$CONFIG_ARGS +exec $RENDERED_CFG"
fi

if [ -z "${NO_LICENSE_KEY}${NO_LICENCE_KEY}" ]; then
    if [ -z "${LICENSE_KEY}" ] && [ -n "${LICENCE_KEY}" ]; then
        LICENSE_KEY="${LICENCE_KEY}"
    fi

    if [ -z "${NO_DEFAULT_CONFIG}" ] && [ -z "${LICENSE_KEY}" ]; then
        >&2 printf "License key not found in environment, please create one at https://keymaster.fivem.net!\n"
        exit 1
    fi

    if [ -z "${CONFIG_ARGS}" ] && [ -n "${LICENSE_KEY}" ] && [ -n "${NO_DEFAULT_CONFIG}" ]; then
        >&2 printf "txadmin does not use the \$LICENSE_KEY environment variable.\nPlease remove it and set it through the txadmin web UI\n\n"
        exit 1
    fi

    CONFIG_ARGS="$CONFIG_ARGS +set sv_licenseKey ${LICENSE_KEY}"
fi

>&2 echo "Starting FiveM Enhanced server..."
exec ./alpine/lib/ld-musl-x86_64.so.1 \
    --library-path "./alpine/lib/:./alpine/usr/lib/" -- \
    ./alpine/opt/cfx-server/cfx-server \
        +set citizen_dir ./alpine/opt/cfx-server/citizen/ \
        $CONFIG_ARGS \
        $*
