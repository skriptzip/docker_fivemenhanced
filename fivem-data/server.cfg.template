endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

start mapmanager
start chat
start spawnmanager
start sessionmanager
start fivem
start hardcap
start rconlog
start scoreboard
start playernames

sv_hostname "${SERVER_NAME}"
sets sv_projectName "${SERVER_NAME}"
sets sv_projectDesc "${SERVER_DESC}"
sets tags "${SERVER_TAGS}"
