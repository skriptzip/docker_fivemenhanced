sv_maxclients ${MAX_CLIENTS}
rcon_password "${RCON_PASSWORD}"

sv_scriptHookAllowed 0
sv_endpointprivacy true

sv_whitelist ${WHITELIST}
sv_pureLevel ${PURE_LEVEL}

sv_logpath "${LOG_PATH}"
sv_logbans ${LOG_BANS}
sv_logheartbeats ${LOG_HEARTBEATS}

set steam_webApiKey "${STEAM_API_KEY}"

